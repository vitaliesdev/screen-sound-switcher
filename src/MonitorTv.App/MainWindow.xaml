<ui:FluentWindow x:Class="MonitorTv.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:MonitorTv.App"
                 xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
                 Title="Screen Sound Switcher" Width="900" Height="780" MinWidth="760" MinHeight="540"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <Style x:Key="RowToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="12" BorderThickness="1" BorderBrush="Transparent"
                                Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="64,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="4,20,0,8" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <!-- colour wash under everything -->
        <Rectangle Fill="{StaticResource WindowWash}" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Screen Sound Switcher" ShowMaximize="False" />

            <!-- One-time safety notice: inline and non-modal, so the window stays usable and draggable. -->
            <Border x:Name="SafetyBanner" Grid.Row="1" Visibility="Collapsed" Margin="20,4,20,6" Padding="16,12"
                    CornerRadius="14" BorderThickness="1"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource TileOrange}" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="22" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="Seguro de pantallas" FontWeight="SemiBold" />
                        <TextBlock x:Name="SafetyText" TextWrapping="Wrap" FontSize="12" Opacity="0.75" Margin="0,2,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Content="Entendido" Appearance="Primary" VerticalAlignment="Center" Click="SafetyOk_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="20,8,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Profile list + new profile -->
                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <DockPanel Margin="0,0,0,12">
                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon QuestionCircle24}"
                                       ToolTip="Ayuda: cómo funciona" Click="Help_Click" />
                            <TextBlock Text="Perfiles" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ui:TextBox x:Name="NewName" PlaceholderText="Nombre del perfil nuevo" Margin="0,0,0,8" />
                        <ui:Button x:Name="CreateButton" Content="Crear con los monitores actuales"
                                   Icon="{ui:SymbolIcon Add24}" HorizontalAlignment="Stretch" Appearance="Primary"
                                   Click="Create_Click" />
                        <ui:Button x:Name="DesignButton" Content="Diseñar pantallas…" Margin="0,8,0,0"
                                   Icon="{ui:SymbolIcon DesignIdeas24}" HorizontalAlignment="Stretch" Click="Design_Click"
                                   ToolTip="Crea un perfil colocando las pantallas aquí, sin cambiar las que tienes ahora mismo." />
                    </StackPanel>
                    <ui:Button x:Name="AudioCycleButton" DockPanel.Dock="Bottom" Content="Alternar sonido…" ToolTip="Un atajo que pasa de una salida de sonido a la siguiente" Margin="0,8,0,0"
                               HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Speaker224}" Click="AudioCycle_Click" />
                    <ui:Button x:Name="RulesButton" DockPanel.Dock="Bottom" Content="Reglas de programas…" ToolTip="Aplica un perfil cuando un programa se abre o se cierra" Margin="0,8,0,0"
                               HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon BranchFork24}" Click="Rules_Click" />
                    <ui:ListView x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ui:ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Grid Margin="0,0,0,6">
                                                <Border x:Name="Bd" Padding="12,10" CornerRadius="12"
                                                        BorderThickness="1" BorderBrush="Transparent"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                    <ContentPresenter />
                                                </Border>
                                                <!-- accent tint for the selected profile -->
                                                <Border x:Name="Tint" CornerRadius="12" IsHitTestVisible="False" Opacity="0"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity"
                                                                                 To="0.16" Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.12" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ui:ListView.ItemContainerStyle>
                        <ui:ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center"
                                            Background="{Binding TileBrush}">
                                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="20" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding HotkeyText}" FontSize="11" Opacity="0.65" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>
                </DockPanel>

                <!-- Details -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="EmptyText" Grid.RowSpan="2" Text="Crea un perfil o selecciona uno de la lista."
                               VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Margin="24,0" />

                    <!-- Always in view, so applying a profile never needs a scroll to the end: title, the actions, and whether there are unsaved changes -->
                    <StackPanel x:Name="DetailHeader" Grid.Row="0" Visibility="Collapsed" Margin="0,0,12,10">
                        <DockPanel Margin="0,0,0,12">
                            <ui:ToggleSwitch x:Name="AdvancedToggle" Content="Avanzado" DockPanel.Dock="Right"
                                             VerticalAlignment="Center" Click="AdvancedToggle_Click" />
                            <Border x:Name="DetailTile" Width="48" Height="48" CornerRadius="13" Margin="0,0,14,0"
                                    Background="{StaticResource TileBlue}">
                                <ui:SymbolIcon x:Name="DetailIcon" Symbol="Desktop24" FontSize="26" Foreground="White" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DetailName" FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DetailKind" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel>
                            <!-- deleting is rare and cannot be undone: an icon at the far end, not a big red button next to Apply -->
                            <ui:Button x:Name="DeleteButton" DockPanel.Dock="Right" Appearance="Transparent" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Icon="{ui:SymbolIcon Delete24}" ToolTip="Eliminar perfil" Click="Delete_Click" />
                            <StackPanel x:Name="DirtyBadge" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="0,0,10,0" Visibility="Collapsed">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Cambios sin guardar" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.9" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="ApplyButton" Content="Aplicar perfil" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                                           Click="Apply_Click" Margin="0,0,8,0" />
                                <ui:Button x:Name="SaveButton" Content="Guardar cambios" Icon="{ui:SymbolIcon Save24}"
                                           Click="Save_Click" IsEnabled="False" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <ScrollViewer x:Name="Details" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,12,0">
                            <!-- Pantallas -->
                            <TextBlock Text="Pantallas" Style="{StaticResource GroupTitle}" />
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <Grid Margin="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Top" Background="{StaticResource TileBlue}">
                                        <ui:SymbolIcon Symbol="Desktop24" FontSize="18" Foreground="White" />
                                    </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="Monitores guardados" FontWeight="SemiBold" />
                                            <TextBlock x:Name="MonitorsText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                            <!-- under the text, not beside it: in languages with longer words the title was cut off -->
                                            <WrapPanel Margin="0,10,0,0">
                                                <ui:Button x:Name="EditScreensButton" Content="Editar pantallas…" Margin="0,0,8,6" Click="EditScreens_Click"
                                                           ToolTip="Elige qué pantallas lleva este perfil y colócalas, sin cambiar nada ahora." />
                                                <ui:Button x:Name="RecaptureButton" Content="Guardar los actuales" Margin="0,0,0,6" Click="Recapture_Click"
                                                           ToolTip="Sustituye la disposición guardada por la que tienes ahora mismo." />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="ArrangementCard">
                                        <Border Style="{StaticResource Divider}" />
                                        <StackPanel Margin="16,12,16,16">
                                            <TextBlock Text="Arrastra las pantallas para colocarlas, o selecciónalas y usa las flechas. Clic derecho o la tecla P para elegir la principal."
                                                       FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <local:ArrangementView x:Name="Arrangement" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Sonido -->
                            <TextBlock Text="Sonido" Style="{StaticResource GroupTitle}" />
                            <Border Style="{StaticResource Group}">
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Top" Background="{StaticResource TilePink}">
                                        <ui:SymbolIcon Symbol="Speaker224" FontSize="18" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="Salida de audio" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <ComboBox x:Name="AudioCombo" HorizontalAlignment="Stretch" IsEditable="True"
                                                  ToolTip="Elige una salida activa o escribe parte del nombre (p. ej. LG) para salidas que aún no están conectadas." />
                                        <TextBlock Text="Se espera hasta 20 s a que la salida aparezca, útil con la tele."
                                                   FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Atajos -->
                            <TextBlock Text="Atajos" Style="{StaticResource GroupTitle}" />
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <Grid Margin="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Top" Background="{StaticResource TileIndigo}">
                                        <ui:SymbolIcon Symbol="Keyboard24" FontSize="18" Foreground="White" />
                                    </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                            <TextBlock Text="Teclado" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <ui:TextBox x:Name="HotkeyBox" IsReadOnly="True" PlaceholderText="Haz clic aquí y pulsa la combinación, p. ej. Ctrl+Alt+F1"
                                                        PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Content="Quitar atajo" VerticalAlignment="Bottom" Click="HotkeyClear_Click" />
                                    </Grid>

                                    <StackPanel x:Name="ControllerCard">
                                        <Border Style="{StaticResource Divider}" />
                                        <Grid Margin="16,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Top" Background="{StaticResource TileGreen}">
                                        <ui:SymbolIcon Symbol="Games24" FontSize="18" Foreground="White" />
                                    </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                <TextBlock Text="Mando" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                <ComboBox x:Name="ControllerPreset" HorizontalAlignment="Stretch"
                                                          SelectionChanged="ControllerPreset_Changed" />

                                                <StackPanel x:Name="ControllerCustom" Visibility="Collapsed" Margin="0,10,0,0">
                                                    <TextBlock Text="Botones de la combinación" FontSize="12" Opacity="0.7" Margin="0,0,0,6" />
                                                    <WrapPanel x:Name="ControllerButtons" />
                                                    <ui:Button x:Name="ControllerRecord" Content="Grabar con el mando" Margin="0,10,0,0"
                                                               Icon="{ui:SymbolIcon Record24}" Click="ControllerRecord_Click" />
                                                </StackPanel>

                                                <TextBlock x:Name="ControllerHint" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Avanzado -->
                            <StackPanel x:Name="AdvancedGroup">
                                <TextBlock Text="Tele" Style="{StaticResource GroupTitle}" />
                                <Border Style="{StaticResource Group}">
                                    <StackPanel>
                                        <ToggleButton x:Name="TvHeader" Style="{StaticResource RowToggle}" Tag="Tv" Click="GroupHeader_Click"
                                                      AutomationProperties.Name="Tele LG (webOS)"
                                                      AutomationProperties.HelpText="Muestra u oculta estos ajustes">
                                            <Grid Margin="16,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Center" Background="{StaticResource TilePurple}">
                                                <ui:SymbolIcon Symbol="Tv24" FontSize="18" Foreground="White" />
                                            </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Tele LG (webOS)" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="TvSummary" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <ui:SymbolIcon x:Name="TvChevron" Grid.Column="2" Symbol="ChevronDown24" FontSize="16" Opacity="0.7"
                                                               VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                                            </Grid>
                                        </ToggleButton>
                                        <StackPanel x:Name="TvBody" Visibility="Collapsed">
                                            <Border Style="{StaticResource Divider}" />
                                            <StackPanel Margin="64,14,16,16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="TvPowerCombo" Grid.Column="0" HorizontalAlignment="Stretch" SelectionChanged="Summary_Changed"
                                                              AutomationProperties.Name="Encendido de la tele" />
                                                    <ComboBox x:Name="TvInputCombo" Grid.Column="2" HorizontalAlignment="Stretch" SelectionChanged="Summary_Changed"
                                                              AutomationProperties.Name="Entrada de la tele" />
                                                </Grid>
                                                <Expander Header="Conexión con la tele" Margin="0,10,0,0">
                                                    <StackPanel Margin="0,8,0,0">
                                                        <ui:TextBox x:Name="TvIp" PlaceholderText="IP, p. ej. 192.168.1.50" Margin="0,0,0,8" />
                                                        <ui:TextBox x:Name="TvMac" PlaceholderText="MAC, p. ej. AA-BB-CC-DD-EE-FF" Margin="0,0,0,8" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:Button Content="Guardar datos" Click="TvSave_Click" Margin="0,0,8,0" />
                                                            <ui:Button x:Name="PairButton" Content="Emparejar con la tele" Click="TvPair_Click" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="TvPairText" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Acciones extra" Style="{StaticResource GroupTitle}" />
                                <Border Style="{StaticResource Group}">
                                    <StackPanel>
                                        <ToggleButton x:Name="LaunchHeader" Style="{StaticResource RowToggle}" Tag="Launch" Click="GroupHeader_Click"
                                                      AutomationProperties.Name="Acciones extra al aplicar"
                                                      AutomationProperties.HelpText="Muestra u oculta estos ajustes">
                                            <Grid Margin="16,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Center" Background="{StaticResource TileOrange}">
                                                <ui:SymbolIcon Symbol="Apps24" FontSize="18" Foreground="White" />
                                            </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Acciones extra al aplicar" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="LaunchSummary" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <ui:SymbolIcon x:Name="LaunchChevron" Grid.Column="2" Symbol="ChevronDown24" FontSize="16" Opacity="0.7"
                                                               VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                                            </Grid>
                                        </ToggleButton>
                                        <StackPanel x:Name="LaunchBody" Visibility="Collapsed">
                                            <Border Style="{StaticResource Divider}" />
                                            <StackPanel Margin="64,14,16,16">
                                                <ui:TextBox x:Name="LaunchBox" AcceptsReturn="True" MinLines="2" MaxLines="4" TextChanged="Summary_Changed"
                                                            PlaceholderText="steam://open/bigpicture" AutomationProperties.Name="Acciones extra, una por línea" />
                                                <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0"
                                                           Text="Una por línea: un programa con sus argumentos, un enlace (steam://…) o una llamada web (GET o POST https://… con el cuerpo opcional). Sirve para cualquier dispositivo con una API, como Home Assistant." />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Height="12" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid Grid.Row="3" Margin="24,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="StatusIcon" Symbol="Info24" FontSize="16" VerticalAlignment="Top" Margin="0,1,8,0" Opacity="0.85" />
                        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Listo." Opacity="0.9" TextWrapping="Wrap" />
                    </Grid>
                    <!-- a safety net must be findable when everything has gone wrong, but quiet while it is not needed: a ghost button, no alarm colour -->
                    <StackPanel Orientation="Horizontal" Margin="-8,4,0,0">
                        <ui:Button x:Name="EmergencyButton" Appearance="Transparent" Padding="8,3" FontSize="12"
                                   Icon="{ui:SymbolIcon ArrowUndo24}" Content="Restaurar pantallas" Click="Emergency_Click"
                                   ToolTip="Vuelve a la última disposición que confirmaste. También funciona con el atajo, aunque la ventana esté cerrada." />
                        <StackPanel x:Name="EmergencyKeys" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- the project links, icon only (their official marks, set in code), apart from the app's own controls -->
                    <ui:Button x:Name="KofiButton" Appearance="Transparent" Visibility="Collapsed" Margin="0,0,6,0" Click="Kofi_Click" />
                    <ui:Button x:Name="GitHubButton" Appearance="Transparent" Visibility="Collapsed" Margin="0,0,6,0" Click="GitHub_Click" />
                    <Border x:Name="LinksGap" Width="1" Height="20" Margin="14,0,14,0" Opacity="0.25" Visibility="Collapsed"
                            Background="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:Button x:Name="ThemeButton" Appearance="Transparent" Icon="{ui:SymbolIcon WeatherMoon24}" Margin="0,0,4,0"
                               ToolTip="Cambiar entre tema claro y oscuro" Click="Theme_Click" />
                    <ui:Button x:Name="SettingsButton" Appearance="Transparent" Icon="{ui:SymbolIcon Settings24}" Margin="0,0,4,0"
                               ToolTip="Ajustes de la app" Click="Settings_Click" />
                    <ui:Button x:Name="HistoryButton" Appearance="Transparent" Icon="{ui:SymbolIcon History24}" Margin="0,0,4,0"
                               ToolTip="Últimos mensajes" Click="History_Click" />
                    <ui:Button x:Name="UpdateButton" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}"
                               Visibility="Collapsed" Margin="0,0,8,0" Click="Update_Click" />
                    <TextBlock x:Name="VersionText" Opacity="0.65" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- no visual of its own; must not sit over the title bar or it can swallow drags -->
            <tray:NotifyIcon x:Name="TrayIcon" Grid.Row="3" TooltipText="Screen Sound Switcher"
                             IsHitTestVisible="False" MenuOnRightClick="True" LeftClick="Tray_LeftClick" />
        </Grid>
    </Grid>
</ui:FluentWindow>
