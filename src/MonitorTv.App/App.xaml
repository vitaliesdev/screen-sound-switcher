<Application x:Class="MonitorTv.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Colour is used sparingly and always means something: one gradient per kind of setting. -->
            <LinearGradientBrush x:Key="TileBlue" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A84FF" Offset="0" />
                <GradientStop Color="#5E5CE6" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TilePurple" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#BF5AF2" Offset="0" />
                <GradientStop Color="#FF375F" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TileTeal" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E9E4A" Offset="0" />
                <GradientStop Color="#0E8FB0" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TilePink" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0264F" Offset="0" />
                <GradientStop Color="#D9480F" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TileOrange" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E8730A" Offset="0" />
                <GradientStop Color="#D9480F" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TileIndigo" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5E5CE6" Offset="0" />
                <GradientStop Color="#2E88E0" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TileGreen" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#23A03F" Offset="0" />
                <GradientStop Color="#0A8F8A" Offset="1" />
            </LinearGradientBrush>

            <!-- A light edge, brighter on top: what makes a translucent panel read as glass. -->
            <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#59FFFFFF" Offset="0" />
                <GradientStop Color="#14FFFFFF" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
